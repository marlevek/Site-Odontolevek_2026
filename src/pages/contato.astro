---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import { siteConfig, getWhatsappLink } from "../data/siteConfig";
import { breadcrumbSchema, dentistSchema } from "../data/schema";

const crumbs = [{ label: "Contato", href: "/contato/" }];
---

<BaseLayout
  title="Contato | Odonto Levek"
  description="Entre em contato com a Odonto Levek pelo WhatsApp para solicitar sua avaliação."
  schema={[dentistSchema(), breadcrumbSchema([{ label: "Início", href: "/" }, ...crumbs])]}
>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <Breadcrumb items={crumbs} />
      <p class="eyebrow">Contato</p>
      <h1>Agende sua avaliação</h1>
      <p>O WhatsApp é o caminho mais rápido para solicitar horários e tirar dúvidas iniciais.</p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-grid">
      <aside class="contact-card">
        <h2>Informações de contato</h2>
        <ul>
          <li><strong>WhatsApp:</strong> {siteConfig.whatsapp}</li>
          <li><strong>Endereço:</strong> {siteConfig.address}</li>
          <li><strong>Cidade:</strong> {siteConfig.city} - {siteConfig.state}</li>
          <li>
            <strong>Horário:</strong>
            <span>{siteConfig.businessHoursLines[0]}</span>
            <span>{siteConfig.businessHoursLines[1]}</span>
          </li>
          <li><strong>CRO:</strong> {siteConfig.cro}</li>
        </ul>
        <div class="button-row" style="margin-top: 22px;">
          <a class="button" href={getWhatsappLink()} target="_blank" rel="noopener">Chamar no WhatsApp</a>
          <a
            class="button button-secondary"
            href={getWhatsappLink("Olá, vim pelo site Odonto Levek e gostaria de tirar uma dúvida.")}
            target="_blank"
            rel="noopener"
          >
            Tirar uma dúvida
          </a>
          <a class="button button-secondary" href={siteConfig.googleMapsUrl} target="_blank" rel="noopener">
            Abrir no mapa
          </a>
        </div>
      </aside>
      <figure class="contact-photo">
        <img
          src="/images/Imagens_Clinica/estaciionamento.jpg"
          width="1381"
          height="1036"
          alt="Estacionamento amplo próximo à Odonto Levek"
          loading="lazy"
        />
        <figcaption>Estacionamento amplo para facilitar sua chegada.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section map-section">
    <div class="container">
      <div class="map-card">
        <iframe
          src={siteConfig.googleMapsEmbedUrl}
          title="Mapa com a localização da Odonto Levek"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>
</BaseLayout>
