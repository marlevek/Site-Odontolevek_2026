---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import SectionTitle from "../components/SectionTitle.astro";
import VideoSection from "../components/VideoSection.astro";
import Faq from "../components/Faq.astro";
import CtaBlock from "../components/CtaBlock.astro";
import { homeFaqs } from "../data/faqs";
import { getWhatsappLink } from "../data/siteConfig";
import { dentistSchema, faqSchema } from "../data/schema";

const differentials = [
  "Atendimento humanizado",
  "Planejamento individual",
  "Odontologia estética e funcional",
  "Estrutura para tratamentos completos",
  "Tecnologia e precisão",
];

const team = [
  {
    role: "Ortodontista",
    text: "Profissional dedicada ao planejamento ortodôntico, com olhar atento para função, estética e conforto em cada etapa do tratamento.",
    image: "/images/dentista-placeholder.svg",
  },
  {
    role: "Implantodontista",
    text: "Especialista em implantodontia e reabilitação oral, conduzindo casos com planejamento cuidadoso e foco na segurança do paciente.",
    image: "/images/Imagens_Clinica/impante.jpg",
  },
  {
    role: "Equipe",
    text: "Responsável por organizar a rotina da clínica, acolher os pacientes e acompanhar cada detalhe para uma experiência mais tranquila.",
    image: "/images/fotos_equipe/IMG-20260612-WA0014.jpg",
  },
  {
    role: "Harmonização orofacial",
    text: "Profissional voltada à harmonização orofacial, com abordagem individualizada e atenção à naturalidade dos resultados.",
    image: "/images/fotos_equipe/IMG-20260612-WA0011.jpg",
  },
  {
    role: "Estética dental",
    text: "Atua na estética do sorriso com cuidado para equilibrar saúde bucal, proporção, forma e naturalidade.",
    image: "/images/dentista-placeholder.svg",
  },
  {
    role: "Endodontista",
    text: "Profissional dedicada à endodontia, realizando tratamentos de canal com atenção ao diagnóstico, conforto e preservação dos dentes.",
    image: "/images/dentista-placeholder.svg",
  },
];

const clinicRoutine = [
  {
    src: "/images/Imagens_Clinica/IMG-20260612-WA0010.jpg",
    width: 720,
    height: 1280,
    alt: "Detalhe de acolhimento preparado para pacientes da Odonto Levek",
    caption: "Acolhimento nos detalhes",
  },
  {
    src: "/images/Imagens_Clinica/IMG-20260612-WA0024.jpg",
    width: 960,
    height: 1280,
    alt: "Recepção da Odonto Levek",
    caption: "Recepção",
  },
  {
    src: "/images/Imagens_Clinica/scanner_digital.jpg",
    width: 2130,
    height: 1597,
    alt: "Scanner digital utilizado na clínica Odonto Levek",
    caption: "Apoio tecnológico",
  },
  {
    src: "/images/fotos_equipe/IMG-20260612-WA0017.jpg",
    width: 1280,
    height: 960,
    alt: "Profissionais da Odonto Levek em foto de equipe",
    caption: "Profissionais da clínica",
  },
];
---

<BaseLayout
  title="Odonto Levek | Odontologia moderna, estética e cuidado"
  description="Clínica odontológica com foco em estética, implantes, próteses, ortodontia, endodontia e harmonização orofacial."
  schema={[dentistSchema(), faqSchema(homeFaqs)]}
>
  <Hero
    eyebrow="Odonto Levek"
    title="Odontologia moderna, estética e cuidado em cada detalhe"
    text="Tratamentos odontológicos completos com atenção individualizada, planejamento cuidadoso e foco na saúde do seu sorriso."
    primaryHref={getWhatsappLink()}
    secondaryHref="/tratamentos/"
  />

  <section class="section">
    <div class="container">
      <SectionTitle
        eyebrow="Diferenciais"
        title="Cuidado técnico, clareza no planejamento e acolhimento desde a avaliação"
        text="Cada tratamento começa com escuta, exame cuidadoso e explicação honesta sobre possibilidades, etapas e cuidados."
      />
      <div class="feature-grid">
        {differentials.map((item) => (
          <article class="feature-item">
            <h3>{item}</h3>
            <p>Uma abordagem pensada para unir saúde, estética e previsibilidade clínica.</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section team-section">
    <div class="container">
      <SectionTitle
        eyebrow="Equipe"
        title="Profissionais preparados para cuidar de diferentes necessidades do seu sorriso"
        text="A Odonto Levek reúne especialidades complementares para orientar cada paciente com clareza desde a avaliação."
      />
      <div class="team-grid">
        {team.map((member) => (
          <article class="team-card">
            <img src={member.image} width="720" height="480" alt={`Imagem relacionada à equipe: ${member.role}`} loading="lazy" />
            <div class="team-card-body">
              <h3>{member.role}</h3>
              <p>{member.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section routine-section">
    <div class="container">
      <SectionTitle
        eyebrow="Rotina da clínica"
        title="Detalhes reais do atendimento, da equipe e dos ambientes"
        text="Alguns registros mostram a rotina da Odonto Levek por dentro: equipe presente, espaços organizados e recursos que apoiam o cuidado."
      />
      <div class="routine-grid">
        {clinicRoutine.map((item) => (
          <figure class="routine-card">
            <img src={item.src} width={item.width} height={item.height} alt={item.alt} loading="lazy" decoding="async" />
            <figcaption>{item.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split-section">
      <div>
        <p class="eyebrow">Por que escolher</p>
        <h2>Uma clínica para quem valoriza explicação clara e acompanhamento próximo</h2>
      </div>
      <div class="split-panel">
        <p>
          O cuidado odontológico precisa ser bonito, mas também precisa ser seguro, funcional e bem explicado.
          A Odonto Levek trabalha com planejamento responsável, evitando promessas fáceis e priorizando decisões clínicas bem orientadas.
        </p>
      </div>
    </div>
  </section>

  <VideoSection />
  <Faq items={homeFaqs} />
  <CtaBlock />
</BaseLayout>
