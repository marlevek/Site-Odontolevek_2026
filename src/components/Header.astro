---
import { getWhatsappLink } from "../data/siteConfig";

const navItems = [
  { href: "/", label: "Início" },
  { href: "/tratamentos/", label: "Tratamentos" },
  { href: "/sobre/", label: "Sobre" },
  { href: "/blog/", label: "Blog" },
  { href: "/contato/", label: "Contato" },
];
---

<a class="skip-link" href="#conteudo">Ir para o conteúdo</a>
<header class="site-header" data-header>
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Odonto Levek">
      <img class="brand-logo" src="/images/logo_OdontoLevek.jpg" width="257" height="84" alt="" aria-hidden="true" />
      <span class="brand-name">Odonto Levek</span>
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-label="Abrir menu"
      aria-expanded="false"
      aria-controls="menu-principal"
      data-menu-toggle
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <nav class="main-nav" id="menu-principal" aria-label="Menu principal" data-main-nav>
      {navItems.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
      <a class="button button-small" href={getWhatsappLink()} target="_blank" rel="noopener">
        Agendar avaliação
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector("[data-menu-toggle]");
  const nav = document.querySelector("[data-main-nav]");

  toggle?.addEventListener("click", () => {
    const isOpen = nav?.classList.toggle("is-open") ?? false;
    toggle.setAttribute("aria-expanded", String(isOpen));
    toggle.setAttribute("aria-label", isOpen ? "Fechar menu" : "Abrir menu");
  });

  nav?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      nav.classList.remove("is-open");
      toggle?.setAttribute("aria-expanded", "false");
      toggle?.setAttribute("aria-label", "Abrir menu");
    });
  });
</script>
