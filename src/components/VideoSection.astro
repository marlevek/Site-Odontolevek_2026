<section class="section media-section">
  <div class="container media-grid">
    <div>
      <p class="eyebrow">Clínica</p>
      <h2>Um espaço preparado para cuidar do seu sorriso com tranquilidade</h2>
      <p>
        Ambientes planejados para receber cada paciente com conforto, higiene, tecnologia e uma rotina de atendimento organizada.
      </p>
    </div>
    <div class="clinic-slider" data-clinic-slider aria-label="Fotos da clínica Odonto Levek">
      <div class="clinic-slider-track" data-clinic-track>
        {clinicPhotos.map((photo, index) => (
          <figure class="clinic-slide" data-clinic-slide>
            <img
              src={photo.src}
              width={photo.width}
              height={photo.height}
              alt={photo.alt}
              loading="lazy"
              decoding="async"
            />
            <figcaption>{photo.caption}</figcaption>
          </figure>
        ))}
      </div>
      <button class="slider-control slider-control-prev" type="button" data-clinic-prev aria-label="Foto anterior">
        <span aria-hidden="true">‹</span>
      </button>
      <button class="slider-control slider-control-next" type="button" data-clinic-next aria-label="Próxima foto">
        <span aria-hidden="true">›</span>
      </button>
      <div class="slider-dots" aria-label="Selecionar foto">
        {clinicPhotos.map((photo, index) => (
          <button
            class={index === 0 ? "is-active" : undefined}
            type="button"
            data-clinic-dot={index}
            aria-label={`Ver foto ${index + 1}: ${photo.caption}`}
            aria-current={index === 0 ? "true" : undefined}
          ></button>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const sliders = document.querySelectorAll("[data-clinic-slider]");

  sliders.forEach((slider) => {
    const track = slider.querySelector("[data-clinic-track]");
    const slides = Array.from(slider.querySelectorAll("[data-clinic-slide]"));
    const dots = Array.from(slider.querySelectorAll("[data-clinic-dot]"));
    const prev = slider.querySelector("[data-clinic-prev]");
    const next = slider.querySelector("[data-clinic-next]");
    let activeIndex = 0;

    function setActive(index) {
      activeIndex = (index + slides.length) % slides.length;
      if (track) {
        track.style.transform = `translateX(-${activeIndex * 100}%)`;
      }
      dots.forEach((dot, dotIndex) => {
        const isActive = dotIndex === activeIndex;
        dot.classList.toggle("is-active", isActive);
        dot.setAttribute("aria-current", isActive ? "true" : "false");
      });
    }

    function showSlide(index) {
      setActive(index);
    }

    prev?.addEventListener("click", () => showSlide(activeIndex - 1));
    next?.addEventListener("click", () => showSlide(activeIndex + 1));
    dots.forEach((dot, index) => dot.addEventListener("click", () => showSlide(index)));
  });
</script>
